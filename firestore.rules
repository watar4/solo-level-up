rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only read/write their own character document.
    match /characters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Quest docs carry a uid field. Splitting per operation keeps the
    // list-query static analyser happy — `resource.data.uid == request.auth.uid`
    // must be unconditional so Firestore can prove `where('uid','==',uid)` is safe.
    match /quests/{questId} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Completion log entries follow the same ownership rule.
    match /completions/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Body-weight entries (1 record per ad-hoc measurement). Same uid-scoped
    // ownership rule pattern as quests/completions.
    match /weightEntries/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Meal log entries (one record per logged meal). Same uid-scoped
    // ownership rule pattern as quests/completions/weightEntries.
    match /meals/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Reusable meal presets (saved meal templates). Same uid-scoped
    // ownership rule pattern as meals.
    match /mealPresets/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Shadow army units — same uid-scoped pattern.
    match /shadows/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Daily boss attempt log — one record per real attempt.
    match /bossAttempts/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Inventory items (weapons, etc.) dropped from boss chests.
    match /items/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Per-user API keys issued from the app UI for non-browser clients.
    // Document ID is the secret itself; this is intentional so weightInbox
    // rules can look up the key in O(1). Only the owner (authenticated) can
    // read/create/delete their own keys.
    match /apiKeys/{key} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create:       if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update:       if false;
    }

    // Focus gate: a publicly-readable "is the gate open today?" doc that an
    // iOS automation polls (no Firebase auth available in a Shortcut). The
    // document id IS an unguessable secret, so `get` is public but `list` is
    // forbidden (you can't enumerate gates without knowing the secret). Only
    // the authenticated owner may write, and only with their own uid.
    match /gates/{secret} {
      allow get:           if true;
      allow list:          if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete:        if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Inbox for body-weight readings posted from iOS Shortcuts / external
    // automation. Anonymous create is allowed *only* when:
    //   1. the payload carries a `secret` field
    //   2. an apiKeys doc with id == that secret exists
    //   3. that apiKeys doc's uid matches the payload uid
    //      (so a leaked key cannot write to a different user's inbox)
    //   4. the weight is a plausible kg value
    // Owners (authenticated) can read & delete their own inbox rows so the
    // web app can drain them. Updates are forbidden (no in-place mutation).
    match /weightInbox/{id} {
      allow create: if request.resource.data.secret is string
                    && exists(/databases/$(database)/documents/apiKeys/$(request.resource.data.secret))
                    && get(/databases/$(database)/documents/apiKeys/$(request.resource.data.secret)).data.uid == request.resource.data.uid
                    && request.resource.data.weight is number
                    && request.resource.data.weight > 20
                    && request.resource.data.weight < 300;
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
