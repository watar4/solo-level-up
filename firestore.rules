rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only read/write their own character document.
    match /characters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Quest docs carry a uid field. Splitting per operation keeps the
    // list-query static analyser happy — `resource.data.uid == request.auth.uid`
    // must be unconditional so Firestore can prove `where('uid','==',uid)` is safe.
    match /quests/{questId} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Completion log entries follow the same ownership rule.
    match /completions/{id} {
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
