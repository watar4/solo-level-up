# Firebase web config — copy to `.env.local` and fill in from Firebase console.
# (These keys are *not* secret for client-side Firebase apps; Firestore security
# rules are what actually protect data. Still kept in .env to make rotation easy.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Override the Vite base path. Default in vite.config.ts is `/solo-level-up/`
# for GH Pages project sites. Set to `/` for local dev only if needed.
# VITE_BASE=/
